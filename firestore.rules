rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Test connection document for initial health check
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users Collection
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 150 &&
        data.displayName is string && data.displayName.size() <= 100 &&
        (data.role == 'teacher' || data.role == 'parent');
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().uid == existing().uid;
      allow delete: if false;
    }

    // Students Collection (handles both 'students' and 'student')
    match /students/{studentId} {
      allow read, write: if true;
    }

    match /student/{studentId} {
      allow read, write: if true;
    }

    // Notices Collection
    function isValidNotice(data) {
      return data.keys().hasAll(['id', 'title', 'content', 'priority']) &&
        data.id is string && data.id.size() <= 64 &&
        data.title is string && data.title.size() <= 200 &&
        data.content is string && data.content.size() <= 5000 &&
        (data.priority == 'urgent' || data.priority == 'important' || data.priority == 'normal');
    }

    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(noticeId) && isValidNotice(incoming());
      allow delete: if isSignedIn() && isValidId(noticeId);
    }

    // Meetings Collection
    function isValidMeeting(data) {
      return data.keys().hasAll(['id', 'parentEmail', 'parentName', 'studentName', 'status']) &&
        data.id is string && data.id.size() <= 64 &&
        data.parentEmail is string && data.parentEmail.size() <= 150 &&
        (data.status == 'pending' || data.status == 'confirmed' || data.status == 'completed' || data.status == 'cancelled');
    }

    match /meetings/{meetingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(meetingId) && isValidMeeting(incoming());
      allow update: if isSignedIn() && isValidId(meetingId) && isValidMeeting(incoming());
      allow delete: if isSignedIn() && isValidId(meetingId);
    }
  }
}
